<view class="stage">
  <view class="wrap">
    <view class="topbar">
      <view class="brand">
        <view class="logo"><text>多</text></view>
        <view>
          <view class="title">多米罗盘</view>
          <view class="sub">公开序列观察台</view>
        </view>
      </view>
      <view class="livebox">
        <view class="clock">{{clock}}</view>
        <view class="badge">
          <view class="dot {{live ? 'hot' : 'off'}}"></view>
          {{statusLabel}} · 北京时间
        </view>
      </view>
    </view>

    <view class="kpis">
      <view class="panel" wx:for="{{indices}}" wx:key="code">
        <view class="kpi-label">{{item.name}}</view>
        <view class="kpi-value price">{{item.priceText}}</view>
        <view class="kpi-sub {{item.cls}}">{{item.pctText}}</view>
      </view>
    </view>

    <view class="kpis four">
      <view class="panel">
        <view class="kpi-label">主题合计</view>
        <view class="kpi-value {{boardSumClass}}">{{boardSumText}}</view>
      </view>
      <view class="panel">
        <view class="kpi-label">靠前主题</view>
        <view class="kpi-value small">{{topBoardName}}</view>
        <view class="kpi-sub {{topBoardClass}}">{{topBoardNet}}</view>
      </view>
      <view class="panel">
        <view class="kpi-label">靠前样本</view>
        <view class="kpi-value small">{{topStockName}}</view>
        <view class="kpi-sub {{topStockClass}}">{{topStockNet}}</view>
      </view>
      <view class="panel">
        <view class="kpi-label">靠前米缸</view>
        <view class="kpi-value small">{{topEtfName}}</view>
        <view class="kpi-label">{{topEtfCode}}</view>
        <view class="kpi-sub {{topEtfClass}}">{{topEtfNet}}</view>
      </view>
    </view>

    <view class="toolbar">
      <view class="seg">
        <view
          wx:for="{{periods}}"
          wx:key="id"
          class="seg-btn {{period === item.id ? 'on' : ''}}"
          data-id="{{item.id}}"
          bindtap="setPeriod"
        >{{item.label}}</view>
      </view>
      <view class="seg">
        <view class="seg-btn {{order === 'in' ? 'on' : ''}}" data-id="in" bindtap="setOrder">正向</view>
        <view class="seg-btn {{order === 'out' ? 'on' : ''}}" data-id="out" bindtap="setOrder">反向</view>
      </view>
    </view>
    <input class="search" placeholder="按代号检索" value="{{query}}" bindinput="onQuery" />

    <view wx:if="{{error}}" class="err">{{error}}</view>

    <view class="panel" wx:if="{{tab !== 'stock' && tab !== 'etf'}}">
      <view class="toolbar tight">
        <view class="kpi-label">主题列表</view>
        <view class="seg">
          <view class="seg-btn {{boardKind === 'industry' ? 'on' : ''}}" data-id="industry" bindtap="setBoardKind">分类一</view>
          <view class="seg-btn {{boardKind === 'concept' ? 'on' : ''}}" data-id="concept" bindtap="setBoardKind">分类二</view>
        </view>
      </view>
      <view class="heat">
        <view
          wx:for="{{boardsView}}"
          wx:key="code"
          class="tile"
          style="background: {{item.bg}};"
          data-item="{{item}}"
          bindtap="openBoard"
        >
          <view class="name">{{item.displayName}}</view>
          <view class="net {{item.netCls}}">{{item.netText}}</view>
          <view class="meta {{item.pctCls}}">{{item.pctText}}</view>
        </view>
      </view>
    </view>

    <view class="panel stock-panel" wx:if="{{tab !== 'board' && tab !== 'etf'}}">
      <view class="kpi-label">样本列表</view>
      <view
        wx:for="{{stocksView}}"
        wx:key="code"
        class="row"
        data-item="{{item}}"
        bindtap="openStock"
      >
        <text class="rank">{{item.rank}}</text>
        <view class="grow">
          <view>{{item.displayName}} <text class="code">{{item.code}}</text></view>
          <view class="bar"><view class="bar-i" style="width: {{item.bar}}; background: {{item.barColor}};"></view></view>
        </view>
        <view class="num">
          <view class="{{item.netCls}}">{{item.netText}}</view>
          <view class="{{item.pctCls}}">{{item.pctText}}</view>
        </view>
      </view>
    </view>

    <view class="panel" wx:if="{{tab === 'etf'}}">
      <view class="kpi-label">米缸观察</view>
      <view
        wx:for="{{etfsView}}"
        wx:key="code"
        class="row"
        data-item="{{item}}"
        bindtap="openEtf"
      >
        <text class="rank">{{item.rank}}</text>
        <view class="grow">
          <view>{{item.displayName}} <text class="code">{{item.code}}</text></view>
          <view class="bar"><view class="bar-i" style="width: {{item.bar}}; background: {{item.barColor}};"></view></view>
        </view>
        <view class="num">
          <view class="{{item.netCls}}">{{item.netText}}</view>
          <view class="{{item.pctCls}}">{{item.pctText}}</view>
        </view>
      </view>
    </view>

    <view class="foot">公开数据整理 · 可能延迟 · 仅供浏览</view>
    <view class="legal-links">
      <text bindtap="goAbout">关于</text>
      <text bindtap="goAgreement">用户协议</text>
      <text bindtap="goPrivacy">隐私政策</text>
      <text bindtap="goDisclaimer">使用说明</text>
      <button class="share-link" open-type="share">分享给好友</button>
    </view>
  </view>

  <view class="tabbar">
    <view class="tab {{tab === 'radar' ? 'on' : ''}}" data-tab="radar" bindtap="setTab">看板</view>
    <view class="tab {{tab === 'board' ? 'on' : ''}}" data-tab="board" bindtap="setTab">主题</view>
    <view class="tab {{tab === 'stock' ? 'on' : ''}}" data-tab="stock" bindtap="setTab">样本</view>
    <view class="tab {{tab === 'etf' ? 'on' : ''}}" data-tab="etf" bindtap="setTab">米缸</view>
    <view class="tab" bindtap="goAbout">关于</view>
  </view>

  <view wx:if="{{picked}}" class="mask" bindtap="closeDetail"></view>
  <view wx:if="{{picked}}" class="drawer">
    <view class="kpi-label">{{pickedKind === 'board' ? '主题详情' : (pickedKind === 'etf' ? '米缸详情' : '结构观察')}}</view>
    <view class="drawer-title">{{picked.displayName}}</view>
    <view class="kpi-label" wx:if="{{picked.code}}">{{picked.code}}</view>
    <view class="kpi-value {{pickedNetClass}}">{{pickedNet}}</view>
    <view class="kpi-sub {{pickedNetClass}}">{{pickedPct}}</view>
    <view class="stack">
      <view wx:for="{{parts}}" wx:key="k" class="stack-i" style="width: {{item.width}}; background: {{item.c}}; opacity: {{item.opacity}};"></view>
    </view>
    <view class="kpis four">
      <view class="panel" wx:for="{{parts}}" wx:key="k">
        <view class="kpi-label">{{item.k}}</view>
        <view class="kpi-value small {{item.cls}}">{{item.text}}</view>
      </view>
    </view>
    <block wx:if="{{pickedKind === 'board'}}">
      <view class="kpi-label">关联样本</view>
      <view wx:for="{{membersView}}" wx:key="code" class="row" data-item="{{item}}" bindtap="openStock">
        <text class="rank">{{item.rank}}</text>
        <view class="grow">{{item.displayName}} <text class="code">{{item.code}}</text></view>
        <view class="num {{item.netCls}}">{{item.netText}}</view>
      </view>
    </block>
    <view class="close" bindtap="closeDetail">关闭</view>
  </view>

  <view wx:if="{{showGate}}" class="gate">
    <view class="gate-card">
      <view class="gate-title">使用说明</view>
      <view class="gate-body">多米罗盘用于浏览公开序列、主题与样本的观察值，仅供对照阅读，不提供决策建议或收益承诺。继续使用前请阅读使用说明。</view>
      <view class="gate-link" bindtap="goDisclaimer">查看《使用说明》</view>
      <view class="gate-btn" bindtap="acceptGate">我已知悉，仅用于浏览</view>
    </view>
  </view>
</view>
